# Local dev config - never commit this file.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Database (Neon: pooler for app, direct host for migrations)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/vaultory?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/vaultory?sslmode=require"

# Sessions (SECRET must be 32+ chars)
SESSION_SECRET="dev-only-session-secret-change-me-0123456789abcdef"
SESSION_TTL_DAYS=30
CROSS_SITE_COOKIES=false
TRUST_PROXY=false

# Vault auto-lock minutes for new accounts (0 = never; users can override)
AUTO_LOCK_MINUTES=15

# Vault key escrow secret - rotating it orphans every escrowed key
VAULT_WRAP_SECRET="dev-only-wrap-secret-change-me-0123456789abcdef"

# Frontend origin
APP_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Email - transport: console | resend | smtp
# console = dev only (prints links, sends nothing)
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_TRANSPORT=console
EMAIL_FROM="Vaultory <no-reply@vaultory.local>"

# Resend (only when EMAIL_TRANSPORT=resend)
# RESEND_API_KEY="re_xxxxxxxxxxxx"

# SMTP (only when EMAIL_TRANSPORT=smtp; sender must be verified on provider)
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true + app password
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-app-password"

# Docker compose config - copy to .env and fill the secrets.
# Compose passes this whole file to the api container, then overrides
# the connection/proxy values that must point at the compose network.

# Postgres (compose-managed)
POSTGRES_USER=vaultory
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=vaultory

# Required secrets - generate with: openssl rand -base64 48
SESSION_SECRET=
VAULT_WRAP_SECRET=

# Web port exposed on the host
WEB_PORT=8080

# API runtime
LOG_LEVEL=info
SESSION_TTL_DAYS=30
AUTO_LOCK_MINUTES=15
CROSS_SITE_COOKIES=false

# Only change these if you serve the web container on a public URL
# APP_URL="http://localhost:8080"
# CORS_ORIGINS="http://localhost:8080"

# Email - console sends nothing; use smtp in production
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_TRANSPORT=console
EMAIL_FROM="Vaultory <no-reply@example.com>"
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="you@example.com"
# SMTP_PASS="smtp-key"
